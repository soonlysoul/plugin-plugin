{
  "description": "plugin-plugin: a framing document approved then modified goes back to review.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/doc-status-guard.sh"],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
